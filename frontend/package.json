{
  "name": "@kimpo/attachment-docx-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Kimpo 附件插件（文档查看与编辑：docx-preview + SuperDoc）前端：surface attachment.open；产物 dist/plugin.umd.js + 随包编辑引擎 dist/superdoc/engine.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/somsne/kimpo-attachment-docx"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.engine.config.ts",
    "test": "vitest run",
    "test:bundle": "node --test scripts/bundle.test.mjs",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "fixtures": "node scripts/make-fixtures.mjs",
    "roundtrip": "node scripts/roundtrip.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
