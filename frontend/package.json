  "dependencies": {
    "@kimposoft/plugin-sdk": "file:../../kimpo-plugin-sdk/frontend",
    "docx-preview": "0.4.1",
    "jszip": "3.10.2",
    "superdoc": "1.47.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "docx": "9.12.0",
    "happy-dom": "20.9.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.4",
    "vue": "3.5.39",
    "vue-tsc": "2.2.12"
  }
}
