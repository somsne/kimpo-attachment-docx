{
  "plugin_id": "com.kimposoft.attachment-docx",
  "version": "1.0.0",
  "sdk_version": "1.1.0-tp.21",
  "kimpo_version": ">=1.2.0",
  "category": "attachment",
  "trust_level": "verified",
  "name": { "zh_CN": "文档编辑器", "en_US": "Document Editor" },
  "description": {
    "zh_CN": "Kimpo 附件插件：Word 文档（docx）查看与编辑（docx-preview + SuperDoc 1.47.2）。AGPL-3.0，源码 https://github.com/somsne/kimpo-attachment-docx",
    "en_US": "Kimpo attachment plugin: view and edit Word documents (docx) with docx-preview and SuperDoc 1.47.2. AGPL-3.0; source at https://github.com/somsne/kimpo-attachment-docx"
  },
  "author": { "name": "KimpoSoft Team" },
  "entry": { "frontend": "frontend/plugin.umd.js" },
  "i18n": { "namespace": "com.kimposoft.attachment-docx", "locales": ["zh-CN", "en-US", "ja-JP", "zh-TW"], "path": "frontend/locales", "default_locale": "zh-CN" },
  "dependencies": { "platform": ">=1.2.0", "plugins": [] },
  "permissions": { "network": [], "storage": false, "exec": false },
  "lifecycle": { "allow_multiple_config_instances": false, "max_config_instances": 1 },
  "capabilities": {
    "frontend": {
      "global_name": "KimpoPlugins.attachment_docx",
      "bundle": "frontend/plugin.umd.js",
      "surfaces": [ { "id": "open", "type": "attachment.open", "priority": 10, "host_caps": ["i18n", "log", "theme", "ui.confirm"] } ]
    },
    "attachment_open": {
      "accepts": { "mime": ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"], "ext": ["docx"] },
      "modes": ["view", "edit"],
      "priority": 10,
      "max_source_bytes": 52428800,
      "max_save_bytes": 20971520
    }
  },
  "schema_compatibility": { "frontend.surface": { "min_version": 1 } }
}
